# CameraSmart — نمونه فایل محیطی
#
# همه تنظیمات با پیشوند CAMERASMART_ قابل بازنویسی هستند. این فایل را به
# .env کپی کنید (کنار همین فایل، داخل پوشه backend) و مقادیر را تغییر دهید.
#
#   Copy-Item backend\.env.example backend\.env
#
# ---------------------------------------------------------------------------
# هویت و شبکه
# ---------------------------------------------------------------------------
CAMERASMART_APP_NAME=CameraSmart
# حالت اشکال‌زدایی: لاگ‌های کامل (DEBUG) را فعال می‌کند
CAMERASMART_DEBUG=false
# آدرس و پورتی که سرور روی آن گوش می‌دهد
CAMERASMART_HOST=127.0.0.1
CAMERASMART_PORT=8000

# ---------------------------------------------------------------------------
# منطقه زمانی (اصلی‌ترین تنظیم زمانی سامانه)
# ---------------------------------------------------------------------------
# همه زمان‌ها در پایگاه داده به وقت جهانی (UTC) ذخیره می‌شوند و فقط برای نمایش
# در رابط کاربری به این منطقه زمانی و تقویم شمسی تبدیل می‌شوند.
# این مقدار برای «برنامه زمانی هشدارها» هم استفاده می‌شود.
CAMERASMART_TIMEZONE=Asia/Tehran

# ---------------------------------------------------------------------------
# مسیر داده‌ها
# ---------------------------------------------------------------------------
# ریشه ذخیره‌سازی: پایگاه داده، تصاویر اشیا، وزن مدل‌ها و لاگ‌ها
# CAMERASMART_DATA_DIR=C:\CameraSmartData

# ---------------------------------------------------------------------------
# پایگاه داده
# ---------------------------------------------------------------------------
# خالی = SQLite محلی (پیش‌فرض، کاملاً آفلاین)
# برای PostgreSQL:
# CAMERASMART_DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/camerasmart
# چاپ تمام دستورهای SQL در لاگ (فقط برای عیب‌یابی؛ بسیار پرحجم است)
# توجه: CAMERASMART_DEBUG دیگر به‌تنهایی SQL را چاپ نمی‌کند.
CAMERASMART_SQL_ECHO=false

# ---------------------------------------------------------------------------
# تشخیص اشیا و استریم
# ---------------------------------------------------------------------------
CAMERASMART_DEFAULT_MODEL=rf-detr-base
# نرخ تشخیص پیش‌فرض (فریم بر ثانیه) — روی GPU ضعیف مقدار کمتری بگذارید
CAMERASMART_DEFAULT_DETECTION_FPS=5
# نرخ فریم پیش‌فرض نمایش
CAMERASMART_DEFAULT_STREAM_FPS=20
# حساسیت حرکت پیش‌فرض (نسبت پیکسل‌های تغییرکرده به کل کادر)
CAMERASMART_MOTION_SENSITIVITY=0.004
# پس از چند ثانیه بی‌حرکتی، شیء «ثابت» در نظر گرفته می‌شود
CAMERASMART_STATIONARY_AFTER_SECONDS=8
# فقط وقتی حرکت دیده شود، تشخیص اجرا می‌شود (صرفه‌جویی در GPU)
CAMERASMART_REQUIRE_MOTION_FOR_DETECTION=true
# دستگاه اجرای مدل: cuda | cuda:0 | cpu
CAMERASMART_DEVICE=cuda
# کیفیت و اندازه تصویر زنده (تصویر زنده فقط وقتی کسی تماشا کند تولید می‌شود)
CAMERASMART_JPEG_QUALITY=80
CAMERASMART_LIVE_MAX_WIDTH=1280
# مسیر ffmpeg/ffprobe (در صورت نبود در PATH)
CAMERASMART_FFMPEG_BIN=ffmpeg
CAMERASMART_FFPROBE_BIN=ffprobe

# ---------------------------------------------------------------------------
# ذخیره‌سازی و نگه‌داری
# ---------------------------------------------------------------------------
# local = پوشه‌بندی بر اساس تاریخ محلی (مناسب اپراتور) | utc = مطابق پایگاه داده
CAMERASMART_STORAGE_DATE_MODE=local
# تعداد روز نگه‌داری تصاویر، رویدادها، معیارهای سلامت و نقشه حرارتی
CAMERASMART_RETENTION_DAYS=30
# اجرای خودکار پاک‌سازی (پیش‌فرض هر ۲۴ ساعت، اولین اجرا ۵ دقیقه پس از راه‌اندازی)
CAMERASMART_RETENTION_AUTO_RUN=true
CAMERASMART_RETENTION_INTERVAL_HOURS=24
# ابعاد شبکه نقشه حرارتی
CAMERASMART_HEATMAP_GRID_W=64
CAMERASMART_HEATMAP_GRID_H=36

# ---------------------------------------------------------------------------
# هشدارها
# ---------------------------------------------------------------------------
CAMERASMART_ALERTS_ENABLED=true
# فاصله ضدتکرار برای هر قاعده هشدار (ثانیه)
CAMERASMART_ALERT_COOLDOWN_SECONDS=30
CAMERASMART_ALERT_SOUND_DEFAULT=true

# ---------------------------------------------------------------------------
# امنیت (رمز ادمین)
# ---------------------------------------------------------------------------
# رمز ادمین در اولین اجرا از رابط کاربری گرفته و به‌صورت scrypt در پایگاه داده
# ذخیره می‌شود؛ نیازی به تعریف آن در این فایل نیست.
# مدت اعتبار هر نشست ورود (ساعت)
CAMERASMART_SESSION_HOURS=12
# تعداد تلاش ناموفق پیش از قفل موقت و مدت قفل (ثانیه)
CAMERASMART_AUTH_MAX_ATTEMPTS=5
CAMERASMART_AUTH_LOCKOUT_SECONDS=60

# ---------------------------------------------------------------------------
# راه‌اندازی
# ---------------------------------------------------------------------------
# ساخت جداول در صورت نبود (برای SQLite؛ در استقرار با Alembic مقدار false)
CAMERASMART_AUTO_CREATE_TABLES=true
# شروع خودکار استریم دوربین‌ها همراه با سرور
CAMERASMART_AUTOSTART_CAMERAS=true

# ---------------------------------------------------------------------------
# CORS (فقط برای توسعه رابط کاربری روی پورت جداگانه لازم است)
# ---------------------------------------------------------------------------
# CAMERASMART_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
